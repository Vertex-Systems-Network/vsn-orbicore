# Required to enroll time-based authenticator fallback. Keep this key outside source control.
# Generate a unique 32-byte value with: openssl rand -base64 32
# Copy this file to .env, fill the key, then export its values before npm run dev.
# Back it up in an approved secret manager; losing it makes enrolled TOTP seeds unreadable.
ORBICORE_MFA_ENCRYPTION_KEY=

# Set to 1 only when the app is served through HTTPS.
ORBICORE_COOKIE_SECURE=0
