{
  "schema_version": 1,
  "records": [
    {
      "id": "OPT-REFRESH-TIMEOUT",
      "key": "providers.cpanel.read_timeout_seconds",
      "type": "integer",
      "default": 20,
      "validation": "Integer 3..120; reject non-integers and values outside range.",
      "scope": "account",
      "security_classification": "internal",
      "capability_requirements": [
        "cPanel UAPI read operation"
      ],
      "dependencies": [
        "OPT-RETRY-COUNT"
      ],
      "help_text": "Maximum time for one read-only provider request. A timeout preserves last-known data and marks it stale.",
      "implementation_status": "planned",
      "test_ids": [
        "INV-TIMEOUT-001"
      ]
    },
    {
      "id": "OPT-RETRY-COUNT",
      "key": "jobs.read_retry_limit",
      "type": "integer",
      "default": 2,
      "validation": "Integer 0..5; exponential backoff with jitter and provider Retry-After respected.",
      "scope": "organization",
      "security_classification": "internal",
      "capability_requirements": [],
      "dependencies": [],
      "help_text": "Bounded retry count for idempotent reads only. Never applies to non-idempotent mutations.",
      "implementation_status": "planned",
      "test_ids": [
        "JOB-RETRY-001"
      ]
    },
    {
      "id": "OPT-CONNECTION-SECRET-REF",
      "key": "connections.secret_reference",
      "type": "string",
      "default": null,
      "validation": "Vault reference only; raw secret values are rejected and never serialized to jobs.",
      "scope": "account",
      "security_classification": "secret_reference",
      "capability_requirements": [],
      "dependencies": [],
      "help_text": "Reference to a scoped, encrypted credential entry. Secret manager integration is not implemented yet.",
      "implementation_status": "not_implemented",
      "test_ids": [
        "SEC-SECRET-001"
      ]
    },
    {
      "id": "OPT-MIGRATION-CUTOVER-APPROVAL",
      "key": "migration.cutover_requires_approval",
      "type": "boolean",
      "default": true,
      "validation": "Must remain true unless an organization policy explicitly authorizes a bounded cutover window.",
      "scope": "organization",
      "security_classification": "sensitive",
      "capability_requirements": [
        "DNS provider mutation capability"
      ],
      "dependencies": [
        "OPT-MIGRATION-ROLLBACK-WINDOW"
      ],
      "help_text": "DNS cutover can change live traffic. It requires approval and a rollback plan by default.",
      "implementation_status": "planned",
      "test_ids": [
        "MIG-DNS-GATE-001"
      ]
    },
    {
      "id": "OPT-MIGRATION-ROLLBACK-WINDOW",
      "key": "migration.rollback_window_minutes",
      "type": "integer",
      "default": 60,
      "validation": "Integer 15..10080; must not expire before the retention/acceptance gate.",
      "scope": "job",
      "security_classification": "sensitive",
      "capability_requirements": [
        "Verified snapshot",
        "Prior DNS record snapshot"
      ],
      "dependencies": [],
      "help_text": "Minimum window to keep recovery available after a cutover.",
      "implementation_status": "planned",
      "test_ids": [
        "MIG-ROLLBACK-001"
      ]
    },
    {
      "id": "OPT-AUTH-SESSION-TTL",
      "key": "auth.session_ttl_seconds",
      "type": "integer",
      "default": 43200,
      "validation": "Integer 300..86400; local default is 12 hours.",
      "scope": "global",
      "security_classification": "sensitive",
      "capability_requirements": [],
      "dependencies": [],
      "help_text": "Expiration interval for opaque local sessions. Production target deployments must review renewal and reauthentication policy.",
      "implementation_status": "implemented",
      "test_ids": [
        "AUTH-SESSION-001"
      ]
    },
    {
      "id": "OPT-AUTH-LOGIN-FAILURE-LIMIT",
      "key": "auth.login_failure_limit",
      "type": "integer",
      "default": 10,
      "validation": "Integer 3..20; failed attempts per process and client IP within the failure window.",
      "scope": "global",
      "security_classification": "internal",
      "capability_requirements": [],
      "dependencies": [],
      "help_text": "Local per-process failed login/bootstrap limit. This is not distributed throttling.",
      "implementation_status": "implemented",
      "test_ids": [
        "AUTH-RATE-001"
      ]
    },
    {
      "id": "OPT-AUTH-LOGIN-FAILURE-WINDOW",
      "key": "auth.login_failure_window_seconds",
      "type": "integer",
      "default": 600,
      "validation": "Integer 60..3600 seconds.",
      "scope": "global",
      "security_classification": "internal",
      "capability_requirements": [],
      "dependencies": [],
      "help_text": "Sliding window for the local per-process failed login limit.",
      "implementation_status": "implemented",
      "test_ids": [
        "AUTH-RATE-001"
      ]
    },
    {
      "id": "OPT-AUTH-PASSWORD-MIN",
      "key": "auth.password_min_length",
      "type": "integer",
      "default": 12,
      "validation": "Integer 10..20 characters; password maximum is 256 characters.",
      "scope": "global",
      "security_classification": "sensitive",
      "capability_requirements": [],
      "dependencies": [],
      "help_text": "Minimum length enforced by the first-owner bootstrap endpoint.",
      "implementation_status": "implemented",
      "test_ids": [
        "SEC-SECRET-001"
      ]
    },
    {
      "id": "OPT-AUTH-COOKIE-SECURE",
      "key": "auth.cookie_secure",
      "type": "boolean",
      "default": false,
      "validation": "Must be true for HTTPS production deployments; only false for loopback development.",
      "scope": "global",
      "security_classification": "sensitive",
      "capability_requirements": [],
      "dependencies": [],
      "help_text": "Set ORBICORE_COOKIE_SECURE=1 behind trusted HTTPS. The local development default is false.",
